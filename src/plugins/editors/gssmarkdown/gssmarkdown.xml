<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="editors" method="upgrade">
	<name>plg_editors_gssmarkdown</name>
	<version>2.8.2</version>
	<creationDate>2026-09</creationDate>
	<author>Galaxy Software Services Corp.</author>
	<authorUrl>https://www.gss.com.tw</authorUrl>
	<copyright>(C) 2026 Galaxy Software Services Corp.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<description>PLG_EDITORS_GSSMARKDOWN_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Plugin\Editors\GssMarkdown</namespace>
	<files>
		<folder plugin="gssmarkdown">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_editors_gssmarkdown" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<file>joomla.asset.json</file>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="height"
					type="text"
					label="PLG_EDITORS_GSSMARKDOWN_HEIGHT_LABEL"
					description="PLG_EDITORS_GSSMARKDOWN_HEIGHT_DESC"
					default="70vh"
					filter="string"
				/>
				<field
					name="preview_debounce"
					type="number"
					label="PLG_EDITORS_GSSMARKDOWN_PREVIEW_DEBOUNCE_LABEL"
					description="PLG_EDITORS_GSSMARKDOWN_PREVIEW_DEBOUNCE_DESC"
					default="300"
					min="150"
					max="2000"
					filter="integer"
				/>
				<field
					name="legacy_mode"
					type="list"
					label="PLG_EDITORS_GSSMARKDOWN_LEGACY_MODE_LABEL"
					description="PLG_EDITORS_GSSMARKDOWN_LEGACY_MODE_DESC"
					default="fallback"
					validate="options"
					>
					<option value="fallback">PLG_EDITORS_GSSMARKDOWN_LEGACY_MODE_FALLBACK</option>
					<option value="convert">PLG_EDITORS_GSSMARKDOWN_LEGACY_MODE_CONVERT</option>
				</field>
				<field
					name="fallback_editor"
					type="plugins"
					folder="editors"
					label="PLG_EDITORS_GSSMARKDOWN_FALLBACK_EDITOR_LABEL"
					description="PLG_EDITORS_GSSMARKDOWN_FALLBACK_EDITOR_DESC"
					default="jce"
					filter="cmd"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
