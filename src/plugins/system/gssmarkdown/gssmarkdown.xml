<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_gssmarkdown</name>
	<version>2.8.2</version>
	<creationDate>2026-09</creationDate>
	<author>Galaxy Software Services Corp.</author>
	<authorUrl>https://www.gss.com.tw</authorUrl>
	<copyright>(C) 2026 Galaxy Software Services Corp.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<description>PLG_SYSTEM_GSSMARKDOWN_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Plugin\System\GssMarkdown</namespace>
	<files>
		<folder plugin="gssmarkdown">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_system_gssmarkdown" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<file>joomla.asset.json</file>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="raw_html"
					type="list"
					label="PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_DESC"
					default="escape"
					validate="options"
					>
					<option value="escape">PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_ESCAPE</option>
					<option value="whitelist">PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_WHITELIST</option>
				</field>
				<field
					name="raw_html_tags"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_TAGS_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_RAW_HTML_TAGS_DESC"
					default="kbd,sub,sup,mark,abbr,details,summary,span,div,dl,dt,dd,figure,figcaption"
					filter="string"
					showon="raw_html:whitelist"
				/>
				<field
					name="frontend_highlight"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_GSSMARKDOWN_FRONTEND_HIGHLIGHT_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_FRONTEND_HIGHLIGHT_DESC"
					default="1"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="preview" label="PLG_SYSTEM_GSSMARKDOWN_FIELDSET_PREVIEW" description="PLG_SYSTEM_GSSMARKDOWN_FIELDSET_PREVIEW_DESC">
				<field
					name="preview_page"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_PAGE_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_PAGE_DESC"
					default=""
					filter="string"
					hint="index.php?option=com_easyblog&amp;view=entry&amp;id=123"
				/>
				<field
					name="preview_selector"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_SELECTOR_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_SELECTOR_DESC"
					default=""
					filter="string"
					hint="[data-blog-content]"
				/>
				<field
					name="preview_fetch_base"
					type="url"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_FETCH_BASE_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_FETCH_BASE_DESC"
					default=""
					filter="url"
					hint="http://localhost/"
				/>
				<field
					name="preview_viewport"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_VIEWPORT_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_VIEWPORT_DESC"
					default="1280"
					min="320"
					max="3840"
					filter="integer"
				/>
				<field
					name="preview_cache_hours"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_CACHE_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_CACHE_DESC"
					default="6"
					min="0"
					filter="integer"
				/>
				<field
					name="preview_custom_css"
					type="textarea"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_CSS_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_CSS_DESC"
					rows="6"
					filter="raw"
				/>
				<field
					name="preview_stylesheets"
					type="textarea"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_STYLESHEETS_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_STYLESHEETS_DESC"
					rows="3"
					filter="string"
				/>
				<field
					name="preview_wrapper_class"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_WRAPPER_LABEL"
					default="gssmd-preview"
					filter="string"
				/>
				<field
					name="preview_max_width"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_MAX_WIDTH_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_MAX_WIDTH_DESC"
					default=""
					filter="string"
					hint="760px"
				/>
				<field
					name="preview_max_kb"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_PREVIEW_MAX_KB_LABEL"
					default="1024"
					min="16"
					filter="integer"
				/>
			</fieldset>
			<fieldset name="images" label="PLG_SYSTEM_GSSMARKDOWN_FIELDSET_IMAGES">
				<field
					name="max_size_mb"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_MAX_SIZE_LABEL"
					default="5"
					min="1"
					max="100"
					filter="integer"
				/>
				<field
					name="max_dir_mb"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_MAX_DIR_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_MAX_DIR_DESC"
					default="200"
					min="1"
					filter="integer"
				/>
				<field
					name="allow_svg"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_GSSMARKDOWN_ALLOW_SVG_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_ALLOW_SVG_DESC"
					default="0"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="easyblog_dir"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_EASYBLOG_DIR_LABEL"
					default="images/easyblog_articles"
					filter="path"
				/>
				<field
					name="tmp_dir"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_TMP_DIR_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_TMP_DIR_DESC"
					default="images/easyblog_articles/.tmp"
					filter="path"
				/>
				<field
					name="generic_dir"
					type="text"
					label="PLG_SYSTEM_GSSMARKDOWN_GENERIC_DIR_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_GENERIC_DIR_DESC"
					default="images/gssmd"
					filter="path"
				/>
				<field
					name="tmp_days"
					type="number"
					label="PLG_SYSTEM_GSSMARKDOWN_TMP_DAYS_LABEL"
					description="PLG_SYSTEM_GSSMARKDOWN_TMP_DAYS_DESC"
					default="7"
					min="1"
					filter="integer"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
